#!/usr/bin/env bash
set -euo pipefail
export WINEPREFIX="$HOME/.local/share/wineprefixes/musicflow"
if [ -z "${DISPLAY:-}" ]; then
    export DISPLAY=":0"
fi
if [ -z "${XAUTHORITY:-}" ]; then
    XAUTH=$(ls -1 /run/user/"$(id -u)"/xauth_* 2>/dev/null | head -n1 || true)
    [ -n "$XAUTH" ] && export XAUTHORITY="$XAUTH"
fi
MF_DIR="$WINEPREFIX/drive_c/Program Files (x86)/LG Software/Music Flow"
cd "$MF_DIR"
exec wine "$MF_DIR/MusicFlow.exe" "$@"
